/* custom-tab-bar/index.wxss */
.custom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #d6e8ff;
  display: flex;
  justify-content: space-around;
  align-items: center;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  transition: all 0.2s ease;
}

.tab-item:active {
  transform: scale(0.95);
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-text {
  font-size: 22rpx;
  color: #94a3b8;
  transition: all 0.2s ease;
}

.tab-text.active {
  color: #2563eb;
  font-weight: 500;
}

/* 首页图标 - 房子 */
.icon-home {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.home-house {
  width: 100%;
  height: 100%;
  background: transparent;
  border: 3rpx solid #94a3b8;
  border-bottom: none;
  border-radius: 8rpx 8rpx 0 0;
  position: relative;
  transition: all 0.2s ease;
}

.home-house::after {
  content: "";
  position: absolute;
  bottom: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-top: 14rpx solid #94a3b8;
  transition: all 0.2s ease;
}

.home-house::before {
  content: "";
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid #94a3b8;
  border-radius: 4rpx;
  transition: all 0.2s ease;
}

.home-house.active {
  background: #2563eb;
  border-color: #2563eb;
}

.home-house.active::after {
  border-top-color: #2563eb;
}

.home-house.active::before {
  background: #fff;
  border-color: #2563eb;
}

/* 跑步图标 - 跑步小人 */
.icon-run {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.run-person {
  width: 100%;
  height: 100%;
  position: relative;
  transition: all 0.2s ease;
}

.run-person::before {
  content: "";
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid #94a3b8;
  border-radius: 50%;
  transition: all 0.2s ease;
}

.run-person::after {
  content: "";
  position: absolute;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 14rpx;
  height: 20rpx;
  border-left: 3rpx solid #94a3b8;
  border-right: 3rpx solid #94a3b8;
  border-bottom: 3rpx solid #94a3b8;
  border-radius: 0 0 8rpx 8rpx;
  transition: all 0.2s ease;
}

.run-person .arm-l,
.run-person .arm-r,
.run-person .leg-l,
.run-person .leg-r {
  position: absolute;
  width: 10rpx;
  height: 3rpx;
  background: #94a3b8;
  border-radius: 2rpx;
  transition: all 0.2s ease;
}

.run-person .arm-l {
  top: 18rpx;
  left: 6rpx;
  transform: rotate(-30deg);
}

.run-person .arm-r {
  top: 18rpx;
  right: 6rpx;
  transform: rotate(30deg);
}

.run-person .leg-l {
  top: 30rpx;
  left: 10rpx;
  transform: rotate(20deg);
}

.run-person .leg-r {
  top: 30rpx;
  right: 10rpx;
  transform: rotate(-20deg);
}

.run-person.active::before {
  border-color: #2563eb;
  background: #2563eb;
}

.run-person.active::after {
  border-color: #2563eb;
  background: #2563eb;
}

.run-person.active .arm-l,
.run-person.active .arm-r,
.run-person.active .leg-l,
.run-person.active .leg-r {
  background: #2563eb;
}

/* 历史图标 - 日历 */
.icon-history {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.history-cal {
  width: 100%;
  height: 100%;
  border: 3rpx solid #94a3b8;
  border-radius: 6rpx;
  position: relative;
  transition: all 0.2s ease;
}

.history-cal::before {
  content: "";
  position: absolute;
  top: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 18rpx;
  height: 10rpx;
  border: 3rpx solid #94a3b8;
  border-bottom: none;
  border-radius: 6rpx 6rpx 0 0;
  transition: all 0.2s ease;
}

.history-cal::after {
  content: "";
  position: absolute;
  top: 8rpx;
  left: 6rpx;
  right: 6rpx;
  height: 2rpx;
  background: #94a3b8;
  transition: all 0.2s ease;
}

.history-cal.active {
  background: #2563eb;
  border-color: #2563eb;
}

.history-cal.active::before {
  background: #2563eb;
  border-color: #2563eb;
}

.history-cal.active::after {
  background: rgba(255, 255, 255, 0.5);
}

/* 跳绳图标 */
.icon-jump {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.jump-icon {
  width: 100%;
  height: 100%;
  position: relative;
  transition: all 0.2s ease;
}

.jump-person {
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 10rpx;
  height: 10rpx;
  border: 3rpx solid #94a3b8;
  border-radius: 50%;
  transition: all 0.2s ease;
}

.jump-person::after {
  content: "";
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 4rpx;
  height: 14rpx;
  background: #94a3b8;
  border-radius: 2rpx;
  transition: all 0.2s ease;
}

.rope-hand-l {
  position: absolute;
  top: 6rpx;
  left: 2rpx;
  width: 8rpx;
  height: 3rpx;
  background: #94a3b8;
  border-radius: 2rpx;
  transform: rotate(20deg);
  transition: all 0.2s ease;
}

.rope-hand-r {
  position: absolute;
  top: 6rpx;
  right: 2rpx;
  width: 8rpx;
  height: 3rpx;
  background: #94a3b8;
  border-radius: 2rpx;
  transform: rotate(-20deg);
  transition: all 0.2s ease;
}

.rope {
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 14rpx;
  border: 3rpx solid #94a3b8;
  border-top: none;
  border-radius: 0 0 50% 50%;
  transition: all 0.2s ease;
}

.jump-icon.active .jump-person {
  border-color: #2563eb;
  background: #2563eb;
}

.jump-icon.active .jump-person::after {
  background: #2563eb;
}

.jump-icon.active .rope-hand-l,
.jump-icon.active .rope-hand-r {
  background: #2563eb;
}

.jump-icon.active .rope {
  border-color: #2563eb;
}
