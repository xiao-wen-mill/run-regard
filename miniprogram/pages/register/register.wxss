/* pages/register/register.wxss */
/* 页面整体 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #ffffff 0%, #eff6ff 100%);
  padding: 40rpx 32rpx;
  padding-top: calc(80rpx + env(safe-area-inset-top));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 - 跑步轨迹线条 */
.container::before {
  content: "";
  position: absolute;
  top: 10%;
  left: 5%;
  width: 350rpx;
  height: 350rpx;
  border: 3rpx solid rgba(59, 130, 246, 0.1);
  border-radius: 50%;
}

.container::after {
  content: "";
  position: absolute;
  bottom: 10%;
  right: 5%;
  width: 450rpx;
  height: 450rpx;
  border: 3rpx solid rgba(59, 130, 246, 0.08);
  border-radius: 50%;
}

/* 装饰跑步小人 */
.decor-runner {
  position: absolute;
  font-size: 40rpx;
  opacity: 0.2;
  animation: float 4s ease-in-out infinite;
}

.decor-runner:nth-child(1) {
  top: 12%;
  right: 15%;
  animation-delay: 0s;
}

.decor-runner:nth-child(2) {
  top: 55%;
  left: 10%;
  animation-delay: 1.5s;
}

.decor-runner:nth-child(3) {
  bottom: 15%;
  right: 10%;
  animation-delay: 3s;
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-15rpx);
  }
}

/* 卡片容器 - 几乎占满屏幕 */
.card {
  width: 100%;
  min-height: calc(88vh - 80rpx);
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  padding: 80rpx 40rpx;
  box-shadow: 0 12rpx 48rpx rgba(59, 130, 246, 0.15);
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

/* 固定纯色圆形头像 */
.avatar-placeholder {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 60rpx;
  position: relative;
  animation: avatarFloat 3s ease-in-out infinite;
}

.avatar-placeholder::after {
  content: "";
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(59, 130, 246, 0.3) 0%,
    transparent 70%
  );
  animation: glow 2s ease-in-out infinite;
}

@keyframes avatarFloat {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

@keyframes glow {
  0%,
  100% {
    opacity: 0.5;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.1);
  }
}

.icon {
  font-size: 90rpx;
  position: relative;
  z-index: 1;
}

/* 昵称输入框 */
.nick-input {
  width: 100%;
  padding: 40rpx 36rpx;
  background: #f0f7ff;
  border-radius: 24rpx;
  font-size: 38rpx;
  margin-bottom: 56rpx;
  border: 3rpx solid #bfdbfe;
  box-sizing: border-box;
  transition: all 0.3s ease;
  position: relative;
  height: 120rpx;
  line-height: 40rpx;
}

.nick-input:focus {
  border-color: #3b82f6;
  box-shadow: 0 0 0 6rpx rgba(59, 130, 246, 0.15);
  background: #fff;
}

.nick-input::placeholder {
  color: #6b7280;
  font-size: 38rpx;
  opacity: 1;
}

/* 输入框装饰 */
.nick-input-wrapper {
  position: relative;
  width: 100%;
}

.nick-input-wrapper::before {
  content: "🏃";
  position: absolute;
  left: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  z-index: 1;
}

.nick-input-wrapper .nick-input {
  padding-left: 84rpx;
}

/* 跑步人装饰分隔线 */
.divider {
  display: flex;
  align-items: center;
  margin-bottom: 48rpx;
  width: 100%;
}

.divider-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #bfdbfe, transparent);
}

.divider-icon {
  margin: 0 24rpx;
  font-size: 32rpx;
}

/* 微信注册按钮 */
.register-btn {
  width: 100%;
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  border: none;
  border-radius: 50rpx;
  padding: 36rpx;
  font-size: 38rpx;
  color: #fff;
  box-shadow: 0 12rpx 36rpx rgba(7, 193, 96, 0.4);
  margin-bottom: 40rpx;
  transition: all 0.3s ease;
}

.register-btn:not([disabled]):active {
  transform: scale(0.98);
}

.register-btn:not([disabled]):hover {
  transform: translateY(-6rpx);
  box-shadow: 0 16rpx 48rpx rgba(7, 193, 96, 0.5);
}

.register-btn[disabled] {
  background: #d1d5db;
  box-shadow: none;
}

/* 勾选区域 */
.checkbox-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: auto;
}

.checkbox-wrap checkbox {
  transform: scale(1.4);
  margin-right: 20rpx;
}

.checkbox-wrap checkbox .wx-checkbox-input {
  border-radius: 8rpx;
  border-color: #d1d5db;
}

.checkbox-wrap checkbox .wx-checkbox-input.wx-checkbox-input-checked {
  background: #3b82f6;
  border-color: #3b82f6;
}

.checkbox-text {
  font-size: 28rpx;
  color: #6b7280;
}

.checkbox-text .link {
  color: #3b82f6;
  text-decoration: underline;
}

/* 页面淡入动画 */
.container {
  animation: fadeIn 0.5s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
