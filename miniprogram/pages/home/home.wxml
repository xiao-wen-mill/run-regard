<view class="container">
  <!-- 顶部标题栏 -->
  <view class="header">
    <text class="header-icon">🏠</text>
    <text class="header-title">运动助手</text>
  </view>
  
  <!-- 1. 用户信息卡片 -->
  <view class="user-card">
    <view class="avatar">
      <text class="avatar-icon">🏃‍♂️</text>
    </view>

    <view class="user-info">
      <text class="nickname">{{userInfo.nickName || '微信用户'}}</text>
      
      <view class="profile-detail">
        <view class="detail-chip" wx:if="{{userInfo.gender && userInfo.gender !== ''}}">
          <text class="chip-icon">{{userInfo.gender === '男' ? '♂' : '♀'}}</text>
          <text>{{userInfo.gender}}</text>
        </view>
        <view class="detail-chip" wx:if="{{userInfo.age && userInfo.age > 0}}">
          <text>{{userInfo.age}}岁</text>
        </view>
        <view class="detail-chip" wx:if="{{userInfo.height && userInfo.height > 0}}">
          <text>{{userInfo.height}}cm</text>
        </view>
        <view class="detail-chip" wx:if="{{userInfo.weight && userInfo.weight > 0}}">
          <text>{{userInfo.weight}}kg</text>
        </view>
        <view class="detail-chip missing" wx:if="{{!userInfo.gender || !userInfo.age || userInfo.age <= 0 || !userInfo.height || userInfo.height <= 0 || !userInfo.weight || userInfo.weight <= 0}}">
          <text class="chip-missing-text">信息待完善</text>
        </view>
      </view>

      <view class="stats-row">
        <view class="stat-item">
          <text class="stat-num">{{totalRunCount || 0}}</text>
          <text class="stat-label">总次数</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num">{{totalDistance || 0}}</text>
          <text class="stat-label">总公里数</text>
        </view>
      </view>
      <view class="edit-entry" bindtap="goToEditProfile">
        <text class="edit-icon">✏️</text>
        <text class="edit-text">编辑资料</text>
      </view>
    </view>
  </view>

  <!-- 快捷开始按钮 -->
  <button class="start-btn" bindtap="goToRun">
    <text>🏃</text>
    <text>开始跑步</text>
  </button>

  <!-- 2. 跑步历史记录区 -->
  <view class="history-card">
    <text class="card-title">跑步历史</text>
    <scroll-view class="history-list" scroll-y>
      <view wx:for="{{historyList}}" wx:key="_id" class="history-item">
        <view class="history-info">
          <text class="history-date">{{item.createTime}}</text>
          <text class="history-detail">{{item.durationText}} · {{item.distanceKm}}公里</text>
        </view>
        <text class="history-calories">{{item.calories}}千卡</text>
      </view>
      
      <view wx:if="{{hasMore}}" class="load-more" bindtap="loadMoreHistory">加载更多</view>
      <view wx:elif="{{historyList.length > 0}}" class="no-more">已经到底啦</view>
      <view wx:else>
        <view class="empty-state">
          <text class="empty-icon">🏃</text>
          <text class="empty-text">还没有跑步记录，快去记录第一条吧~</text>
        </view>
      </view>
    </scroll-view>
  </view>
  
  <!-- 自定义底部导航栏 -->
  <custom-tab-bar></custom-tab-bar>
</view>