/* pages/home/home.wxss */
/* 页面整体 */
.container {
  min-height: 100vh;
  background: #e8f2ff;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 顶部标题栏 */
.header {
  background: #d6e8ff;
  padding: 60rpx 32rpx 32rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.header-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1e3a5f;
  flex: 1;
  text-align: center;
}

/* 用户信息卡片 */
.user-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
}

/* 头像 */
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
}

.avatar-icon {
  font-size: 50rpx;
}

/* 用户信息 */
.user-info {
  flex: 1;
}

.user-info .nickname {
  font-size: 32rpx;
  font-weight: bold;
  color: #1e3a5f;
  display: block;
  margin-bottom: 12rpx;
}

.stats-row {
  display: flex;
  gap: 40rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.stat-num {
  font-size: 28rpx;
  font-weight: bold;
  color: #2563eb;
}

.stat-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.stat-divider {
  width: 2rpx;
  height: 36rpx;
  background: #e5e7eb;
  margin-left: 12rpx;
}

/* 快捷开始按钮 */
.start-btn {
  background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
  border: none;
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 0 24rpx 24rpx;
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.25);
  transition: all 0.2s ease;
}

.start-btn:active {
  transform: scale(0.98);
}

/* 跑步历史记录卡片 */
.history-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 卡片标题 */
.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1e3a5f;
  margin-bottom: 20rpx;
  padding-left: 12rpx;
  border-left: 4rpx solid #3b82f6;
}

/* 历史记录列表 */
.history-list {
  max-height: 400rpx;
}

/* 列表项 */
.history-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  transition: background 0.2s ease;
}

.history-item:last-child {
  border-bottom: none;
}

.history-item:active {
  background: #f8fafc;
}

/* 左侧蓝色竖条 */
.history-item::before {
  content: "";
  width: 4rpx;
  height: 48rpx;
  background: linear-gradient(180deg, #3b82f6 0%, #60a5fa 100%);
  border-radius: 2rpx;
  margin-right: 16rpx;
}

/* 内容区 */
.history-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.history-date {
  font-size: 26rpx;
  color: #374151;
}

.history-detail {
  font-size: 22rpx;
  color: #6b7280;
}

/* 卡路里标签 */
.history-calories {
  background: #eff6ff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

/* 底部状态提示 */
.load-more,
.no-more,
.empty-tip {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
}

.load-more {
  color: #3b82f6;
}

.no-more {
  color: #9ca3af;
}

.empty-tip {
  color: #9ca3af;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  border: 2rpx dashed #d1d5db;
  border-radius: 16rpx;
  background: #f9fafb;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 24rpx;
  color: #6b7280;
}

/* 页面淡入动画 */
.container {
  animation: pageFadeIn 0.4s ease;
}

@keyframes pageFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
