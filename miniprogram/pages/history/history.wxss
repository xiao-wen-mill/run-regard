.container {
  min-height: 100vh;
  background: #e8f2ff;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: pageFadeIn 0.4s ease;
}

.header {
  background: #d6e8ff;
  padding: 60rpx 32rpx 32rpx;
  display: flex;
  align-items: center;
}

.header-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1e3a5f;
  flex: 1;
  text-align: center;
}

.tabs {
  display: flex;
  background: #ffffff;
  margin: 24rpx 24rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #6b7280;
  font-weight: 500;
  transition: all 0.25s ease;
  position: relative;
}

.tab-active {
  color: #2563eb;
  background: linear-gradient(180deg, #eff6ff 0%, #ffffff 100%);
  font-weight: 600;
}

.tab-active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #3b82f6, #60a5fa);
  border-radius: 3rpx;
}

.content {
  padding: 24rpx;
}

.list {
  max-height: calc(100vh - 360rpx - env(safe-area-inset-bottom));
}

.item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.item:active {
  transform: scale(0.98);
}

.top {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.runner-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.date {
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
}

.row {
  display: flex;
  justify-content: space-between;
}

.row + .row {
  margin-top: 12rpx;
}

.cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 8rpx 0;
}

.cell:first-child {
  padding-left: 40rpx;
  position: relative;
}

.cell:first-child::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 36rpx;
  background: linear-gradient(180deg, #3b82f6 0%, #60a5fa 100%);
  border-radius: 2rpx;
}

.cell:last-child {
  align-items: flex-end;
}

.label {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 6rpx;
}

.val {
  font-size: 26rpx;
  font-weight: 500;
  color: #1e3a5f;
}

.val.highlight {
  font-size: 32rpx;
  font-weight: bold;
  color: #2563eb;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx;
  margin-top: 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 26rpx;
  color: #9ca3af;
  text-align: center;
}

@keyframes pageFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
