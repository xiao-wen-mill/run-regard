<view class="container">
  <view class="header">
    <text class="header-icon">📋</text>
    <text class="header-title">跑步历史</text>
  </view>

  <view class="content">
    <scroll-view scroll-y class="list">
      <view wx:for="{{recordList}}" wx:key="_id" class="item">
        <view class="top">
          <text class="runner-icon">🏃</text>
          <text class="date">{{item.createTimeText}}</text>
        </view>
        <view class="row">
          <view class="cell">
            <text class="label">时长</text>
            <text class="val">{{item.durationText}}</text>
          </view>
          <view class="cell">
            <text class="label">距离</text>
            <text class="val">{{item.distanceKm}} km</text>
          </view>
        </view>
        <view class="row">
          <view class="cell">
            <text class="label">配速</text>
            <text class="val">{{item.paceText}} /km</text>
          </view>
          <view class="cell">
            <text class="label">卡路里</text>
            <text class="val">{{item.calories}} 千卡</text>
          </view>
        </view>
      </view>

      <view wx:if="{{recordList.length === 0}}" class="empty">
        <text class="empty-icon">🏃</text>
        <text class="empty-text">暂无跑步记录</text>
      </view>
    </scroll-view>
  </view>
  
  <custom-tab-bar></custom-tab-bar>
</view>